{
  "name": "parakeet-cpp",
  "version-date": "2026-07-22",
  "port-version": 1,
  "description": "CI overlay of parakeet-cpp built from the Zbig9000/qvac-ext-lib-whisper.cpp fork branch (QVAC-22470-parakeet-coreml) so the monorepo CI validates the unmerged Apple Core ML encoder work. Overrides the registry port for parakeet-cpp only; remove once the library merges upstream.",
  "homepage": "https://github.com/tetherto/qvac-ext-lib-whisper.cpp/tree/master/engines/parakeet",
  "license": "MIT",
  "dependencies": [
    {
      "name": "ggml-speech",
      "version>=": "2026-07-14"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    {
      "name": "coreml",
      "platform": "osx | ios"
    },
    {
      "name": "metal",
      "platform": "osx | ios"
    },
    {
      "name": "opencl",
      "platform": "android"
    },
    {
      "name": "vulkan",
      "platform": "windows | linux | android"
    }
  ],
  "features": {
    "coreml": {
      "description": "Enable the Apple Core ML (Neural Engine) encoder sidecar (Apple-only; presence-driven at runtime).",
      "supports": "osx | ios"
    },
    "cuda": {
      "description": "Enable CUDA GPU acceleration",
      "dependencies": [
        {
          "name": "ggml-speech",
          "features": [
            "cuda"
          ]
        }
      ]
    },
    "metal": {
      "description": "Enable Metal GPU acceleration (macOS / iOS)",
      "dependencies": [
        {
          "name": "ggml-speech",
          "features": [
            "metal"
          ]
        }
      ]
    },
    "opencl": {
      "description": "Enable OpenCL GPU acceleration (Android / Adreno)",
      "dependencies": [
        {
          "name": "ggml-speech",
          "features": [
            "opencl"
          ]
        }
      ]
    },
    "vulkan": {
      "description": "Enable Vulkan GPU acceleration",
      "dependencies": [
        {
          "name": "ggml-speech",
          "features": [
            "vulkan"
          ]
        }
      ]
    }
  }
}
